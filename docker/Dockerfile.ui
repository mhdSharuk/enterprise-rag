FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# No ML stack needed — the UI is a thin HTTP client to the API service
COPY requirements/ui.txt ./requirements/
RUN pip install --no-cache-dir -r requirements/ui.txt

COPY src/ui.py ./src/
COPY employees_list.txt .

EXPOSE 8501

CMD ["streamlit", "run", "src/ui.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
